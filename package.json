{
  "name": "practice-desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node scripts/node-suite.mjs all",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "build:static": "node scripts/build-static.mjs",
    "test:fast": "node scripts/node-suite.mjs fast",
    "test:deep": "node scripts/node-suite.mjs deep",
    "qa:fast": "npm run typecheck && npm run build && npm run test:fast",
    "qa:deep": "npm run test:deep"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "esbuild": "0.25.12",
    "playwright-core": "1.64.1"
  },
  "dependencies": {
    "katex": "0.19.1",
    "ts-fsrs": "6.0.0",
    "wordgard": "0.6.2"
  }
}
