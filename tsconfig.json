{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@director/calendar": ["vendor/calendar/src/index.ts"],
      "@director/calendar/integration/practice-desk": ["vendor/calendar/src/integration/practice-desk.ts"],
      "@director/calendar/integration/common": ["vendor/calendar/src/integration/common.ts"],
      "@director/calendar/adapters/practice-desk": ["vendor/calendar/src/adapters/practice-desk.ts"]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
